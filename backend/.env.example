# Server
PORT=3000
NODE_ENV=production

# PostgreSQL (use connection string format for Render)
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_compressor

# Compression Engine (auto-set in Docker to /usr/local/bin/compressor)
# COMPRESSOR_PATH=/usr/local/bin/compressor

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret